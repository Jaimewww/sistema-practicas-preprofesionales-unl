# Variables de entorno del backend (todas opcionales: los valores por defecto
# de backend/config/settings.py son seguros para desarrollo local).
#
# Uso:  cp .env.example .env  (o exportar las variables manualmente)

DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=True
#DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
