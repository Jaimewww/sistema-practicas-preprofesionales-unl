    <bpmn:dataStoreReference id="DSR_S1" name="Registro de prácticas, reportes y horas" dataStoreRef="DataStore_Registro" />
    <bpmn:dataStoreReference id="DSR_S2" name="Registro de prácticas, reportes y horas" dataStoreRef="DataStore_Registro" />
    <bpmn:textAnnotation id="AN1"><bpmn:text>Reglas (RF-02, RF-15, RNF-05): práctica en curso con plan aprobado, semana libre, horas ≥ 1, ayudantía ≤ 10 h, PDF ≤ 5 MB.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="AN2"><bpmn:text>El cierre (RF-09) exige además informe final, informe externo y evaluación ≥ 70 %; es otro proceso (CU-02).</bpmn:text></bpmn:textAnnotation>
    <bpmn:dataStoreReference id="DSR_S3" name="Registro de prácticas, reportes y horas" dataStoreRef="DataStore_Registro" />
