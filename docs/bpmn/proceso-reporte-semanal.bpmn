    <bpmn:sequenceFlow id="SF_C05" sourceRef="GC1" targetRef="GC2" name="Sí"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reporte vencido o horas por debajo del umbral de rezago</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF_C06" sourceRef="GC2" targetRef="C6e" name="Sí"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ya existe una alerta activa por la misma causa</bpmn:conditionExpression></bpmn:sequenceFlow>
