    <bpmn:association id="Assoc_AN2" sourceRef="AN2" targetRef="A15e" />
  </bpmn:process>
  <bpmn:process id="Process_Entidad" name="Proceso del tutor de la entidad" isExecutable="false">
    <bpmn:startEvent id="N_s0" name="Reporte por confirmar recibido"><bpmn:outgoing>SF_N01</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_PorConfirmar" /></bpmn:startEvent>
    <bpmn:userTask id="N_t1" name="Confirmar reporte semanal"><bpmn:documentation>RF-08, HU-07 (criterio 2). Pantalla /prototipo/entidad/practicas/&lt;id&gt;/reportes/&lt;semana&gt;/; sin endpoint API (pendiente #78).</bpmn:documentation><bpmn:incoming>SF_N01</bpmn:incoming><bpmn:outgoing>SF_N02</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="N_e1" name="Confirmación enviada"><bpmn:incoming>SF_N02</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_N01" sourceRef="N_s0" targetRef="N_t1" />
    <bpmn:sequenceFlow id="SF_N02" sourceRef="N_t1" targetRef="N_e1" />
  </bpmn:process>
  <bpmn:process id="Process_Tutor" name="Proceso del tutor académico" isExecutable="false">
    <bpmn:startEvent id="T_s0" name="Reporte pendiente de revisión recibido"><bpmn:outgoing>SF_T01</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_Pendiente" /></bpmn:startEvent>
    <bpmn:userTask id="T_t1" name="Revisar actividades, horas y evidencias"><bpmn:documentation>CU-01 pasos 1-4, HU-03. Pantalla T2 /prototipo/tutor/pendientes/&lt;clave&gt;/.</bpmn:documentation><bpmn:incoming>SF_T01</bpmn:incoming><bpmn:outgoing>SF_T02</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="T_g1" name="¿Reporte cumple lo reportado?" default="SF_T04"><bpmn:incoming>SF_T02</bpmn:incoming><bpmn:outgoing>SF_T03</bpmn:outgoing><bpmn:outgoing>SF_T04</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T_t2" name="Validar horas reportadas"><bpmn:documentation>RF-03, RF-04. PATCH /prototipo/api/v1/pendientes/&lt;clave&gt;/ {"decision": "aprobado"}.</bpmn:documentation><bpmn:incoming>SF_T03</bpmn:incoming><bpmn:outgoing>SF_T05</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="T_e1" name="Reporte validado"><bpmn:incoming>SF_T05</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="T_t3" name="Devolver reporte con observaciones"><bpmn:documentation>RF-03. PATCH /prototipo/api/v1/pendientes/&lt;clave&gt;/ {"decision": "devuelto", "observacion": "..."}.</bpmn:documentation><bpmn:incoming>SF_T04</bpmn:incoming><bpmn:outgoing>SF_T06</bpmn:outgoing><bpmn:dataOutputAssociation id="DA_02"><bpmn:targetRef>DOR_T_d1</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
    <bpmn:endEvent id="T_e2" name="Reporte devuelto"><bpmn:incoming>SF_T06</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="T_s1" name="Alerta recibida"><bpmn:outgoing>SF_T07</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_Alerta" /></bpmn:startEvent>
    <bpmn:userTask id="T_t4" name="Atender alerta del sistema"><bpmn:documentation>RF-07, HU-06. GET /prototipo/api/v1/alertas/.</bpmn:documentation><bpmn:incoming>SF_T07</bpmn:incoming><bpmn:outgoing>SF_T08</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="T_e3" name="Alerta atendida"><bpmn:incoming>SF_T08</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T01" sourceRef="T_s0" targetRef="T_t1" />
    <bpmn:sequenceFlow id="SF_T02" sourceRef="T_t1" targetRef="T_g1" />
    <bpmn:sequenceFlow id="SF_T03" sourceRef="T_g1" targetRef="T_t2" name="Sí"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">El reporte cumple lo reportado</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF_T04" sourceRef="T_g1" targetRef="T_t3" name="No" />
