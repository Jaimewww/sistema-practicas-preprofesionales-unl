<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ReporteSemanal" name="Reporte semanal de actividades de práctica preprofesional" targetNamespace="http://sistema-practicas-unl/bpmn/reporte-semanal" exporter="bpmn.io" exporterVersion="manual">
  <bpmn:collaboration id="Collaboration_ReporteSemanal">
    <bpmn:participant id="Participant_Estudiante" name="Estudiante" processRef="Process_Estudiante" />
    <bpmn:participant id="Participant_Sistema" name="Sistema de seguimiento de prácticas" processRef="Process_Sistema" />
    <bpmn:participant id="Participant_Entidad" name="Tutor de la entidad receptora" processRef="Process_Entidad" />
    <bpmn:participant id="Participant_Tutor" name="Tutor académico" processRef="Process_Tutor" />
    <bpmn:participant id="Participant_Coordinador" name="Coordinador de prácticas" />
    <bpmn:messageFlow id="MF_01" name="Reporte semanal enviado" sourceRef="E_t1" targetRef="A1" messageRef="Msg_Reporte" />
    <bpmn:messageFlow id="MF_02" name="Rechazo con mensaje de error" sourceRef="A3" targetRef="E_c1" messageRef="Msg_Rechazo" />
    <bpmn:messageFlow id="MF_03" name="Reporte devuelto con observaciones" sourceRef="A11" targetRef="E_c2" messageRef="Msg_Devolucion" />
    <bpmn:messageFlow id="MF_04" name="Validación notificada" sourceRef="A14" targetRef="E_c3" messageRef="Msg_Validacion" />
    <bpmn:messageFlow id="MF_05" name="Reporte pendiente de revisión" sourceRef="A6" targetRef="T_s0" messageRef="Msg_Pendiente" />
    <bpmn:messageFlow id="MF_06" name="Reporte por confirmar" sourceRef="A7" targetRef="N_s0" messageRef="Msg_PorConfirmar" />
    <bpmn:messageFlow id="MF_07" name="Confirmación del reporte" sourceRef="N_t1" targetRef="B1" messageRef="Msg_Confirmacion" />
    <bpmn:messageFlow id="MF_08" name="Decisión: validado" sourceRef="T_t2" targetRef="A8" messageRef="Msg_Decision" />
    <bpmn:messageFlow id="MF_09" name="Decisión: devuelto con observación" sourceRef="T_t3" targetRef="A8" messageRef="Msg_Decision" />
    <bpmn:messageFlow id="MF_10" name="Alerta de revisión pendiente" sourceRef="A9" targetRef="T_s1" messageRef="Msg_Alerta" />
    <bpmn:messageFlow id="MF_11" name="Alerta de atraso" sourceRef="C4" targetRef="T_s1" messageRef="Msg_Alerta" />
    <bpmn:messageFlow id="MF_12" name="Alerta de atraso" sourceRef="C4" targetRef="E_s1" messageRef="Msg_Alerta" />
    <bpmn:messageFlow id="MF_13" name="Alerta de atraso" sourceRef="C4" targetRef="Participant_Coordinador" messageRef="Msg_Alerta" />
  </bpmn:collaboration>
  <bpmn:message id="Msg_Reporte" name="Reporte semanal" />
  <bpmn:message id="Msg_Rechazo" name="Rechazo con mensaje de error" />
  <bpmn:message id="Msg_Devolucion" name="Reporte devuelto" />
  <bpmn:message id="Msg_Validacion" name="Validación notificada" />
  <bpmn:message id="Msg_Pendiente" name="Reporte pendiente de revisión" />
  <bpmn:message id="Msg_PorConfirmar" name="Reporte por confirmar" />
  <bpmn:message id="Msg_Confirmacion" name="Confirmación del reporte" />
  <bpmn:message id="Msg_Decision" name="Decisión del tutor académico" />
  <bpmn:message id="Msg_Alerta" name="Alerta del sistema" />
  <bpmn:error id="Error_ReporteRechazado" name="Reporte rechazado" errorCode="REPORTE_RECHAZADO" />
  <bpmn:dataStore id="DataStore_Registro" name="Registro de prácticas, reportes y horas" />
  <bpmn:process id="Process_Estudiante" name="Proceso del estudiante" isExecutable="false">
    <bpmn:startEvent id="E_s0" name="Cierra la semana de práctica"><bpmn:outgoing>SF_E01</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1W</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
    <bpmn:exclusiveGateway id="E_m1"><bpmn:incoming>SF_E01</bpmn:incoming><bpmn:incoming>SF_E08</bpmn:incoming><bpmn:incoming>SF_E10</bpmn:incoming><bpmn:outgoing>SF_E02</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="E_t1" name="Registrar reporte semanal"><bpmn:documentation>HU-02, RF-02, RF-15, RNF-05. POST /api/v1/practicas/&lt;id&gt;/reportes/ (semana, actividades, horas, evidencias PDF ≤ 5 MB).</bpmn:documentation><bpmn:incoming>SF_E02</bpmn:incoming><bpmn:outgoing>SF_E03</bpmn:outgoing><bpmn:dataOutputAssociation id="DA_01"><bpmn:targetRef>DOR_E_d1</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
    <bpmn:eventBasedGateway id="E_g1" name="¿Qué responde el sistema?"><bpmn:incoming>SF_E03</bpmn:incoming><bpmn:outgoing>SF_E04</bpmn:outgoing><bpmn:outgoing>SF_E05</bpmn:outgoing><bpmn:outgoing>SF_E06</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="E_c1" name="Rechazo recibido"><bpmn:incoming>SF_E04</bpmn:incoming><bpmn:outgoing>SF_E07</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_Rechazo" /></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="E_t4" name="Corregir datos del reporte"><bpmn:documentation>HU-02, RNF-05. Se corrige el dato inválido y se reenvía por el mismo endpoint.</bpmn:documentation><bpmn:incoming>SF_E07</bpmn:incoming><bpmn:outgoing>SF_E08</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="E_c2" name="Devolución recibida"><bpmn:incoming>SF_E05</bpmn:incoming><bpmn:outgoing>SF_E09</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_Devolucion" /></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="E_t2" name="Revisar observaciones del tutor"><bpmn:documentation>HU-03 (criterio 2). GET /api/v1/practicas/&lt;id&gt;/ (reporte con observación y versiones).</bpmn:documentation><bpmn:incoming>SF_E09</bpmn:incoming><bpmn:outgoing>SF_E10</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="E_c3" name="Validación recibida"><bpmn:incoming>SF_E06</bpmn:incoming><bpmn:outgoing>SF_E11</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_Validacion" /></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="E_t5" name="Consultar horas validadas acumuladas"><bpmn:documentation>HU-04, RF-05. GET /api/v1/practicas/&lt;id&gt;/ (horas_validadas, horas_en_revision, horas_requeridas).</bpmn:documentation><bpmn:incoming>SF_E11</bpmn:incoming><bpmn:outgoing>SF_E12</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="E_e1" name="Semana reportada y validada"><bpmn:incoming>SF_E12</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="E_s1" name="Alerta de atraso recibida"><bpmn:outgoing>SF_E13</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_Alerta" /></bpmn:startEvent>
    <bpmn:userTask id="E_t6" name="Revisar alerta de atraso"><bpmn:documentation>HU-06, RF-07. GET /prototipo/api/v1/alertas/.</bpmn:documentation><bpmn:incoming>SF_E13</bpmn:incoming><bpmn:outgoing>SF_E14</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="E_e2" name="Atraso conocido"><bpmn:incoming>SF_E14</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_E01" sourceRef="E_s0" targetRef="E_m1" />
    <bpmn:sequenceFlow id="SF_E02" sourceRef="E_m1" targetRef="E_t1" />
    <bpmn:sequenceFlow id="SF_E03" sourceRef="E_t1" targetRef="E_g1" />
    <bpmn:sequenceFlow id="SF_E04" sourceRef="E_g1" targetRef="E_c1" />
    <bpmn:sequenceFlow id="SF_E05" sourceRef="E_g1" targetRef="E_c2" />
    <bpmn:sequenceFlow id="SF_E06" sourceRef="E_g1" targetRef="E_c3" />
    <bpmn:sequenceFlow id="SF_E07" sourceRef="E_c1" targetRef="E_t4" />
    <bpmn:sequenceFlow id="SF_E08" sourceRef="E_t4" targetRef="E_m1" />
    <bpmn:sequenceFlow id="SF_E09" sourceRef="E_c2" targetRef="E_t2" />
    <bpmn:sequenceFlow id="SF_E10" sourceRef="E_t2" targetRef="E_m1" />
    <bpmn:sequenceFlow id="SF_E11" sourceRef="E_c3" targetRef="E_t5" />
    <bpmn:sequenceFlow id="SF_E12" sourceRef="E_t5" targetRef="E_e1" />
    <bpmn:sequenceFlow id="SF_E13" sourceRef="E_s1" targetRef="E_t6" />
    <bpmn:sequenceFlow id="SF_E14" sourceRef="E_t6" targetRef="E_e2" />
    <bpmn:dataObjectReference id="DOR_E_d1" name="Reporte semanal" dataObjectRef="DO_E_d1" />
    <bpmn:dataObject id="DO_E_d1" />
  </bpmn:process>
  <bpmn:process id="Process_Sistema" name="Proceso del sistema" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Sistema">
      <bpmn:lane id="Lane_Gestion" name="Gestión de reportes">
        <bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GA1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GA2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GA2m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GA3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GA3m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A8b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A9e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GA4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A11e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GA5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A15e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A16e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Control" name="Control de atrasos">
        <bpmn:flowNodeRef>C0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GC1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GC2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C5e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C6e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A1" name="Reporte semanal recibido"><bpmn:outgoing>SF_A01</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_Reporte" /></bpmn:startEvent>
    <bpmn:serviceTask id="A2" name="Verificar reglas del reporte"><bpmn:documentation>RF-02, RF-11, RF-15, RNF-05. facade.registrar_reporte + forms.ReporteSemanalForm: práctica en_curso, plan validado, semana libre, horas ≥ 1, ayudantía ≤ 10 h (Art. 341), evidencias PDF ≤ 5 MB.</bpmn:documentation><bpmn:incoming>SF_A01</bpmn:incoming><bpmn:outgoing>SF_A02</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GA1" name="¿Reporte cumple las reglas?" default="SF_A03"><bpmn:incoming>SF_A02</bpmn:incoming><bpmn:outgoing>SF_A03</bpmn:outgoing><bpmn:outgoing>SF_A04</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="A3" name="Rechazar reporte con mensaje de error" messageRef="Msg_Rechazo"><bpmn:documentation>Contrato de errores de docs/api.md §2 y §5: 403, 409 o 422; no cambia ningún dato.</bpmn:documentation><bpmn:incoming>SF_A03</bpmn:incoming><bpmn:outgoing>SF_A05</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="A3e" name="Reporte rechazado"><bpmn:incoming>SF_A05</bpmn:incoming><bpmn:errorEventDefinition errorRef="Error_ReporteRechazado" /></bpmn:endEvent>
    <bpmn:serviceTask id="A4" name="Registrar reporte en revisión"><bpmn:documentation>HU-02 (criterio 1), RF-02. Respuesta 201: estado en_revision, fecha de envío; las horas aún no cuentan (HU-02 criterio 2).</bpmn:documentation><bpmn:incoming>SF_A04</bpmn:incoming><bpmn:outgoing>SF_A06</bpmn:outgoing><bpmn:dataOutputAssociation id="DA_03"><bpmn:targetRef>DSR_S1</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GA2" name="¿Supera 40 horas sin ser ayudantía?" default="SF_A08"><bpmn:incoming>SF_A06</bpmn:incoming><bpmn:outgoing>SF_A07</bpmn:outgoing><bpmn:outgoing>SF_A08</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A5" name="Marcar reporte para revisión del tutor"><bpmn:documentation>HU-02 (criterio 4), COR-07. Pendiente: no está implementado en el prototipo.</bpmn:documentation><bpmn:incoming>SF_A07</bpmn:incoming><bpmn:outgoing>SF_A09</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GA2m"><bpmn:incoming>SF_A08</bpmn:incoming><bpmn:incoming>SF_A09</bpmn:incoming><bpmn:outgoing>SF_A10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GA3" name="¿Práctica laboral con tutor de entidad?" default="SF_A12"><bpmn:incoming>SF_A10</bpmn:incoming><bpmn:outgoing>SF_A11</bpmn:outgoing><bpmn:outgoing>SF_A12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="A7" name="Notificar reporte al tutor de la entidad" messageRef="Msg_PorConfirmar"><bpmn:documentation>RF-08, HU-07, Art. 337. Solo práctica laboral; el servicio comunitario no tiene tutor de entidad.</bpmn:documentation><bpmn:incoming>SF_A11</bpmn:incoming><bpmn:outgoing>SF_A13</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="GA3m"><bpmn:incoming>SF_A12</bpmn:incoming><bpmn:incoming>SF_A13</bpmn:incoming><bpmn:outgoing>SF_A14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="A6" name="Notificar reporte al tutor académico" messageRef="Msg_Pendiente"><bpmn:documentation>HU-01..03, RF-03. Bandeja T1 del tutor (/prototipo/tutor/pendientes/).</bpmn:documentation><bpmn:incoming>SF_A14</bpmn:incoming><bpmn:outgoing>SF_A15</bpmn:outgoing></bpmn:sendTask>
    <bpmn:receiveTask id="A8" name="Esperar decisión del tutor académico" messageRef="Msg_Decision"><bpmn:documentation>RF-03. PATCH /prototipo/api/v1/pendientes/&lt;clave&gt;/ con decision aprobado o devuelto.</bpmn:documentation><bpmn:incoming>SF_A15</bpmn:incoming><bpmn:outgoing>SF_A16</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:boundaryEvent id="A8b" name="Vence plazo de revisión (5 días hábiles)" cancelActivity="false" attachedToRef="A8"><bpmn:documentation>HU-06 (criterio 2), RF-07, RF-12. 5 días hábiles por defecto, configurable por carrera.</bpmn:documentation><bpmn:outgoing>SF_A17</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:sendTask id="A9" name="Emitir alerta de revisión pendiente" messageRef="Msg_Alerta"><bpmn:documentation>RF-07, HU-06 (criterio 2). GET /prototipo/api/v1/alertas/ (revisión vencida).</bpmn:documentation><bpmn:incoming>SF_A17</bpmn:incoming><bpmn:outgoing>SF_A18</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="A9e" name="Alerta de revisión emitida"><bpmn:incoming>SF_A18</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="GA4" name="¿Decisión del tutor académico?" default="SF_A22"><bpmn:incoming>SF_A16</bpmn:incoming><bpmn:outgoing>SF_A19</bpmn:outgoing><bpmn:outgoing>SF_A22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A10" name="Registrar devolución con observación"><bpmn:documentation>RF-03, RF-04. La observación es obligatoria (máx. 500 caracteres); sin ella responde 422.</bpmn:documentation><bpmn:incoming>SF_A19</bpmn:incoming><bpmn:outgoing>SF_A20</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="A11" name="Devolver reporte al estudiante" messageRef="Msg_Devolucion"><bpmn:documentation>HU-03 (criterio 2). El reporte pasa a devuelto y conserva sus versiones (RF-10).</bpmn:documentation><bpmn:incoming>SF_A20</bpmn:incoming><bpmn:outgoing>SF_A21</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="A11e" name="Reporte devuelto"><bpmn:incoming>SF_A21</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="A12" name="Registrar validación con autor y fecha"><bpmn:documentation>RF-04, HU-03 (criterio 1), CE-02. validado_por y validado_el.</bpmn:documentation><bpmn:incoming>SF_A22</bpmn:incoming><bpmn:outgoing>SF_A23</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="A13" name="Sumar horas al acumulado validado"><bpmn:documentation>RF-05, HU-04. Solo cuentan las horas validadas (S-04).</bpmn:documentation><bpmn:incoming>SF_A23</bpmn:incoming><bpmn:outgoing>SF_A24</bpmn:outgoing><bpmn:dataOutputAssociation id="DA_04"><bpmn:targetRef>DSR_S2</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:sendTask id="A14" name="Notificar validación al estudiante" messageRef="Msg_Validacion"><bpmn:documentation>HU-04 (criterio 1).</bpmn:documentation><bpmn:incoming>SF_A24</bpmn:incoming><bpmn:outgoing>SF_A25</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="GA5" name="¿Horas validadas alcanzan el total requerido?" default="SF_A27"><bpmn:incoming>SF_A25</bpmn:incoming><bpmn:outgoing>SF_A26</bpmn:outgoing><bpmn:outgoing>SF_A27</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A15" name="Pasar práctica a revisión final"><bpmn:documentation>Estados de la práctica: en curso → en revisión final (RF-09 y HU-08 dependen de este estado). Pendiente: transición no implementada.</bpmn:documentation><bpmn:incoming>SF_A26</bpmn:incoming><bpmn:outgoing>SF_A28</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="A15e" name="Práctica en revisión final"><bpmn:incoming>SF_A28</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="A16e" name="Semana validada, horas pendientes"><bpmn:incoming>SF_A27</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="B1" name="Confirmación de la entidad recibida"><bpmn:outgoing>SF_B01</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_Confirmacion" /></bpmn:startEvent>
    <bpmn:serviceTask id="B2" name="Registrar confirmación de la entidad"><bpmn:documentation>RF-08, HU-07 (criterio 2): quién confirmó y cuándo.</bpmn:documentation><bpmn:incoming>SF_B01</bpmn:incoming><bpmn:outgoing>SF_B02</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="B3" name="Confirmación registrada"><bpmn:incoming>SF_B02</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="C0" name="Llega la verificación diaria"><bpmn:outgoing>SF_C01</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
    <bpmn:serviceTask id="C2" name="Calcular horas esperadas a la fecha"><bpmn:documentation>CU-03 paso 2: horas requeridas × (días transcurridos ÷ días del período).</bpmn:documentation><bpmn:incoming>SF_C01</bpmn:incoming><bpmn:outgoing>SF_C02</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="C3" name="Verificar reportes vencidos y horas rezagadas"><bpmn:documentation>RF-07, RF-12, HU-06. Reporte sin enviar tras el plazo (3 días por defecto) o horas validadas + en revisión &lt; 80 % de las esperadas.</bpmn:documentation><bpmn:incoming>SF_C02</bpmn:incoming><bpmn:outgoing>SF_C03</bpmn:outgoing><bpmn:dataInputAssociation id="DA_05"><bpmn:sourceRef>DSR_S3</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GC1" name="¿Hay atraso?" default="SF_C04"><bpmn:incoming>SF_C03</bpmn:incoming><bpmn:outgoing>SF_C04</bpmn:outgoing><bpmn:outgoing>SF_C05</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GC2" name="¿Existe alerta activa por la misma causa?" default="SF_C07"><bpmn:incoming>SF_C05</bpmn:incoming><bpmn:outgoing>SF_C06</bpmn:outgoing><bpmn:outgoing>SF_C07</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="C4" name="Notificar alerta de atraso" messageRef="Msg_Alerta"><bpmn:documentation>RF-07, HU-06, CU-03. Destinatarios: estudiante, tutor académico y coordinador. GET /prototipo/api/v1/alertas/.</bpmn:documentation><bpmn:incoming>SF_C07</bpmn:incoming><bpmn:outgoing>SF_C08</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="C4e" name="Alerta de atraso emitida"><bpmn:incoming>SF_C08</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="C5e" name="Sin atraso"><bpmn:incoming>SF_C04</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="C6e" name="Alerta ya vigente"><bpmn:incoming>SF_C06</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_A01" sourceRef="A1" targetRef="A2" />
