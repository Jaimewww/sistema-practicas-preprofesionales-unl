@startuml c4-codigo
title C4 nivel 4 (código) - Backend de seguimiento de prácticas\nMódulos reales de backend/apps al cierre de la Sumativa 1 (2026-11-12)

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #E8F1FB
  BorderColor #2E6DA4
}
skinparam class {
  BackgroundColor<<demo>> #EEEEEE
  BorderColor<<demo>> #777777
  BorderStyle<<demo>> dashed
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #B59B2E
}
hide empty members

legend right
  | Trazo continuo | Código de producción en backend/apps |
  | Trazo discontinuo y fondo gris | Demo del prototipo, aislado en /prototipo/ |
  Los módulos de Python se dibujan como «módulo» con sus funciones públicas.
endlegend

note as N1
  **Estado al 2026-11-12.**
  No quedan clases «planificado»: la capa DRF de #76-#79 está mergeada
  y estos son los nombres reales de backend/apps.
end note

' ---------------------------------------------------------------- API real
package "backend/apps/contrato (implementado)" {

  class SuccessEnvelopeRenderer <<BaseRenderer>> {
    +media_type
    +render(data, accepted_media_type, renderer_context)
  }

  class "exceptions.py" as ContratoExceptions <<módulo>> {
    +envelope_exception_handler(exc, context)
  }
}

package "backend/apps/seguridad (implementado)" {

  class "api.py" as SeguridadApi <<módulo>> {
    +TokenObtainEnvelopeView : POST /api/v1/auth/token/
    +TokenRefreshEnvelopeView : POST /api/v1/auth/token/refresh/
    +LogoutView : POST /api/v1/auth/logout/
  }

  class "permissions.py" as SeguridadPermisos <<módulo>> {
    +rol_requerido(*roles, mensaje=None)
    +PermitirPracticaVisible
    +SinFilaEs401
    +AbiertoSoloEnDebug
  }
}

package "backend/apps/usuarios (implementado)" {

  class Usuario <<AbstractUser>> {
    +nombre
    +email
    +rol
    +carrera
    +clean()
  }

  class "permissions.py" as UsuariosPermisos <<módulo>> {
    +practicas_visibles_para(usuario, practicas=None)
  }
}

package "backend/apps/carreras (implementado)" {
  class Carrera <<Model>>
  class ConfiguracionCarrera <<Model>> {
    +horas_requeridas
    +plazo_reporte_dias
    +plazo_revision_dias
    +umbral_rezago
    +vigente_desde
  }
}

package "backend/apps/entidades (implementado)" {
  class EntidadReceptora <<Model>>
}

package "backend/apps/practicas (implementado)" {

  class Practica <<Model>> {
    +estudiante
    +tipo
    +subtipo
    +proyecto_vinculacion
    +estado
    +horas_requeridas
    +clean()
  }

  class Periodo <<Model>>
  class AsignacionTutor <<Model>>

  class "api.py" as PracticasApi <<módulo>> {
    +PracticasListaView : GET /api/v1/practicas/
    +PracticaDetalleView : GET /api/v1/practicas/<id>/
    +PracticaCardSerializer
  }

  class "services.py" as PracticasServices <<módulo>> {
    +asignar_practica(practica, autor, ...)
    +cambiar_estado_practica(practica, nuevo_estado, autor, motivo)
  }
}

package "backend/apps/actividades (implementado)" {

  class PlanActividades <<Model>> {
    +practica
    +version
    +contenido
    +estado
  }

  class Validacion <<Model>> {
    +practica
    +plan
    +reporte
    +decision
    +observacion
    +autor
    +fecha
    +clean()
  }

  class "services.py" as ActividadesServices <<módulo>> {
    +enviar_plan(practica, contenido, autor)
    +devolver_plan(plan, autor, observacion)
    +aprobar_plan(plan, autor)
  }
}

package "backend/apps/reportes (implementado)" {

  class ReporteSemanal <<Model>> {
    +practica
    +semana
    +horas_reportadas
    +estado
    +requiere_revision
    +save()
  }

  class ReporteSemanalSerializer <<ModelSerializer>> {
    +validate(attrs)
  }

  class ReportePracticaView <<APIView>> {
    +POST /api/v1/practicas/<id>/reportes/
  }
}

package "backend/apps/auditoria (implementado)" {

  class HistorialEstado <<Model>> {
    +practica
    +estado_anterior
    +estado_nuevo
    +autor
    +fecha
    +motivo
  }

  class HistorialEstadoQuerySet <<QuerySet>> {
    +update(**kwargs) : rechaza
    +delete() : rechaza
    +bulk_update(objs, fields) : rechaza
    +bulk_create(objs) : rechaza
  }
}

package "backend/apps/observability (implementado)" {
  class RequestIdMiddleware <<Middleware>> {
    +__call__(request)
  }
  class RequestIdFilter <<logging.Filter>>
  class JsonFormatter <<logging.Formatter>>
}

package "backend/apps/health (implementado)" {
  class "views.py" as Health <<módulo>> {
    +health(request) : 200 / 503
  }
}

' ---------------------------------------------------------------- Demo aislado
package "backend/apps/prototipo (demo, fuera de /api/v1/)" #F2F2F2 {

  class "api.py" as Api <<módulo;demo>> {
    +json_error(status, code, message, **extra)
    +error_json(request, error)
    +error_de_escritura(request, error)
    +lista_alertas(request, rol)
    +historial_practica(request, rol, practica_id)
    +legalizar_anexo(request, rol, anexo_id)
    +cierre_practica(request, rol, practica_id)
    +decidir_pendiente(request, rol, clave)
  }

  class "facade.py" as Facade <<módulo;demo>> {
    +practicas_de(rol, envios, estado, decisiones)
    +alertas_de(rol, tipo, ...)
    +cerrar_practica(practica_id, rol, ...)
    +historial_de(practica_id, rol, ...)
    +legalizar_anexo(anexo_id, rol, estado)
    +registrar_reporte(practica_id, rol, data, files, ...)
  }

  class "dto.py" as Dto <<módulo;demo>> {
    +to_practica_dto(practica, resumido)
    +to_alerta_dto(alerta, rol)
    +to_historial_dto(entrada)
    +to_anexo_dto(anexo)
  }

  class "validaciones.py" as Validaciones <<módulo;demo>> {
    +LIMITE_COOKIE = 3500
    +LIMITE_OBSERVACION = 500
    +localizar(clave, estado)
    +registrar(pendiente, estado, datos)
    +decidir(clave, estado, datos)
  }

  class ReporteSemanalForm <<forms.Form;demo>> {
    +semana
    +actividades
    +horas
    +evidencias
    +clean_horas()
  }

  class "coordinador.py / secretaria.py" as Estado <<módulo;demo>> {
    +TRANSICIONES
    +firmar_estado(estado)
  }

  class "sample_data.py" as SampleData <<módulo;demo>> {
    +get_practica(clave)
    +practicas_todas()
    +alertas_de(practica, configuracion)
    +requisitos_cierre(practica)
  }

  class "views.py" as Views <<módulo;demo>> {
    +solo_en_debug(view)
    +reporte_semanal_nuevo(request)
    +revisar(request, clave)
  }
}

' ---------------------------------------------------------------- Relaciones
PracticasApi ..> PracticasServices
PracticasApi ..> UsuariosPermisos : alcance de filas
PracticasApi ..> SeguridadPermisos : rol y objeto
PracticasApi ..> SuccessEnvelopeRenderer : respuesta
ReportePracticaView ..> ReporteSemanalSerializer
ReportePracticaView ..> SeguridadPermisos : rol y objeto
ReportePracticaView ..> ReporteSemanal : persiste
ReporteSemanalSerializer ..> ReporteSemanal
ActividadesServices ..> PlanActividades
ActividadesServices ..> Validacion
ActividadesServices ..> PracticasServices : transición del plan
PracticasServices ..> HistorialEstado : escribe en la transacción
PracticasServices ..> ConfiguracionCarrera : copia horas al asignar
HistorialEstado --> HistorialEstadoQuerySet : objects
Usuario "*" --> "0..1" Carrera
Practica "*" --> "1" Usuario : estudiante
Practica "*" --> "0..1" EntidadReceptora
Practica "1" *-- "0..*" ReporteSemanal
Practica "1" *-- "0..*" PlanActividades
Practica "1" *-- "0..*" Validacion
Practica "1" *-- "0..*" HistorialEstado
ContratoExceptions ..> SuccessEnvelopeRenderer
SeguridadApi ..> SuccessEnvelopeRenderer : envelope
RequestIdMiddleware ..> RequestIdFilter

' El demo sigue en pie y aislado: no comparte prefijo con la API real (#102)
Api ..> Facade
Api ..> Validaciones
Api ..> Estado
Views ..> Facade
Facade ..> Dto
Facade ..> SampleData
Facade ..> ReporteSemanalForm
Validaciones ..> SampleData

@enduml
