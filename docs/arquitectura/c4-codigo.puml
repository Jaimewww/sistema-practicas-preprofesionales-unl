@startuml c4-codigo
title C4 nivel 4 (código) - Backend de seguimiento de prácticas\nImplementado hoy (apps/prototipo) y capa DRF planificada (#76 a #79)

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #E8F1FB
  BorderColor #2E6DA4
}
skinparam class {
  BackgroundColor<<planificado>> #EEEEEE
  BorderColor<<planificado>> #777777
  BorderStyle<<planificado>> dashed
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #B59B2E
}
hide empty members

legend right
  | Trazo continuo | Implementado en backend/apps |
  | Trazo discontinuo y fondo gris | «planificado» (aún no existe) |
  Los módulos de Python se dibujan como «módulo» con sus funciones públicas.
endlegend

note as N1
  **Actualizar al mergear #76 y #78.**
  Las clases «planificado» usan los nombres de data-model.md
  y de los issues; se ajustan a las clases reales mergeadas.
end note

' ---------------------------------------------------------------- Implementado
package "backend/apps/prototipo (implementado)" {

  class "api.py" as Api <<módulo>> {
    +json_error(status, code, message, **extra)
    +error_json(request, error)
    +error_de_escritura(request, error)
    -_demo(metodo, *roles, formatea, exenta_csrf, conocidos)
    +lista_practicas(request, rol)
    +detalle_practica(request, rol, practica_id)
    +lista_alertas(request, rol)
    +historial_practica(request, rol, practica_id)
    +legalizar_anexo(request, rol, anexo_id)
    +cierre_practica(request, rol, practica_id)
    +reportes_practica(request, rol, practica_id)
    +decidir_pendiente(request, rol, clave)
  }

  class "facade.py" as Facade <<módulo>> {
    +ROLES
    +SESSION_KEY
    +practicas_de(rol, envios, estado, decisiones)
    +practica_de_id(practica_id, rol, ...)
    +alertas_de(rol, tipo, ...)
    +cerrar_practica(practica_id, rol, ...)
    +historial_de(practica_id, rol, ...)
    +legalizar_anexo(anexo_id, rol, estado)
    +formulario_reporte(practica, data, files)
    +registrar_reporte(practica_id, rol, data, files, ...)
  }

  class PracticeQueryError <<excepción>> {
    +status : int
    +code : str
    +form
    +extra : dict
  }

  class "dto.py" as Dto <<módulo>> {
    +PRACTICE_FIELDS
    +REPORT_FIELDS
    +to_practica_dto(practica, resumido)
    +to_reporte_dto(report)
    +to_alerta_dto(alerta, rol)
    +to_historial_dto(entrada)
    +to_anexo_dto(anexo)
  }

  class "validaciones.py" as Validaciones <<módulo>> {
    +COOKIE
    +LIMITE_COOKIE = 3500
    +LIMITE_OBSERVACION = 500
    +DECISIONES
    +leer_estado(request)
    +guardar_estado(request, response, estado)
    +localizar(clave, estado)
    +leer_cuerpo(raw)
    +registrar(pendiente, estado, datos)
    +decidir(clave, estado, datos)
    +to_pendiente_dto(pendiente)
  }

  class ReporteSemanalForm <<forms.Form>> {
    +semana
    +actividades
    +horas
    +evidencias
    +clean_horas()
    +clean_evidencias()
  }

  class MultipleFileField <<forms.FileField>> {
    +clean(data, initial)
  }

  class "coordinador.py / secretaria.py" as Estado <<módulo>> {
    +TRANSICIONES
    +leer_estado(request)
    +firmar_estado(estado)
  }

  class "sample_data.py" as SampleData <<módulo>> {
    +get_practica(clave)
    +practicas_todas()
    +alertas_de(practica, configuracion)
    +requisitos_cierre(practica)
  }

  class "views.py (solo_en_debug)" as Views <<módulo>> {
    +solo_en_debug(view)
    +reporte_semanal_nuevo(request)
    +revisar(request, clave)
  }
}

package "backend/apps/health (implementado)" {
  class "views.py" as Health <<módulo>> {
    +health(request)
  }
}

Api ..> Facade
Api ..> Validaciones : decidir_pendiente
Api ..> Estado : cierre_practica, legalizar_anexo
Api ..> PracticeQueryError : traduce a JSON
Views ..> Facade
Facade ..> Dto
Facade ..> SampleData
Facade ..> ReporteSemanalForm
Facade ..> PracticeQueryError : lanza
Validaciones ..> SampleData
Validaciones ..> Dto : DOCUMENT_FIELDS, REPORT_FIELDS
Validaciones ..> PracticeQueryError : lanza
ReporteSemanalForm *-- MultipleFileField : evidencias

' ---------------------------------------------------------------- Planificado
package "Capa DRF planificada (#76 a #79, #86)" #F2F2F2 {

  package "api/" #F2F2F2 {
    class PracticaViewSet <<planificado>> {
      +list(request)
      +retrieve(request, pk)
      +reportes(request, pk) : POST
    }
    class PracticaSerializer <<planificado>>
    class ReporteSerializer <<planificado>> {
      +validate_horas(value)
      +validate_evidencias(value)
    }
    class EnvelopeRenderer <<planificado>> {
      +render(data, accepted_media_type, renderer_context)
    }
    class "exception_handler" as ExceptionHandler <<planificado>> {
      +envelope_exception_handler(exc, context)
    }
    class EsEstudiantePropietario <<planificado>> {
      +has_permission(request, view)
      +has_object_permission(request, view, obj)
    }
    class EsTutorAsignado <<planificado>>
    class EsCoordinadorDeCarrera <<planificado>>
    class RequestIdMiddleware <<planificado>> {
      +__call__(request)
    }
  }

  package "application/" #F2F2F2 {
    class RegistrarReporte <<planificado>> {
      +ejecutar(practica_id, usuario, datos)
    }
    class ConsultarPracticas <<planificado>> {
      +ejecutar(usuario, practica_id)
    }
  }

  package "domain/" #F2F2F2 {
    class ReglasReporte <<planificado>> {
      +validar_horas_ayudantia(horas)
      +semana_disponible(practica, semana)
      +es_aprobada(porcentaje) : regla del 70 %
    }
  }

  package "infrastructure/" #F2F2F2 {
    class Practica <<planificado>> {
      +estudiante
      +tipo
      +estado
      +horas_requeridas
    }
    class Reporte <<planificado>> {
      +semana
      +actividades
      +horas
      +estado
    }
    class Evidencia <<planificado>> {
      +archivo : FileField
      +version
    }
    class Usuario <<planificado>> {
      +email
      +rol
    }
    class PracticaRepository <<planificado>> {
      +para_usuario(usuario)
      +obtener(practica_id, usuario)
    }
    class ReporteRepository <<planificado>> {
      +crear(practica, datos)
    }
  }
}

