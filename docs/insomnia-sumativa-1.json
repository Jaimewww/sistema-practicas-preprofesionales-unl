      "name": "01 — POST /api/v1/auth/token/",
      "method": "POST",
      "url": "{{ base_url }}/api/v1/auth/token/",
      "description": "Obtiene el par JWT. Respuesta con el envelope universal {\"data\": {\"access\": \"...\", \"refresh\": \"...\"}}.",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "authentication": {
        "type": "bearer",
        "token": "{{ access_token }}"
      },
      "parameters": [],
      "body": {
        "mimeType": "application/json",
        "text": "{\"username\": \"{{ usuario }}\", \"password\": \"{{ password }}\"}"
      },
      "metaSortKey": 0,
      "settingFollowRedirects": "global",
      "tests": "try {\n  const body = insomnia.response.json();\n  insomnia.environment.set('access_token', body.data.access);\n  insomnia.environment.set('refresh_token', body.data.refresh);\n} catch (e) { /* Insomnia anterior: copia data.access a mano en 01 */ }",
