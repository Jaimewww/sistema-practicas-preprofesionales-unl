---
interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{titulo} · Prácticas UNL</title>
  </head>
  <body>
    <nav>
      <a href="/">Inicio</a> · <a href="/login">Iniciar sesión</a> · <a href="/reportes/nuevo">Registrar horas</a>
    </nav>
    <main>
      <h1>{titulo}</h1>
      <slot />
    </main>
  </body>
</html>
